    "smoke:participantes": "esbuild scripts/smokeParticipantes.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-participantes.cjs --log-level=error && node node_modules/.cache/smoke-participantes.cjs",
