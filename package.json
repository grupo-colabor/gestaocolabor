    "smoke:grade-paginacao": "esbuild scripts/smokeGradePaginacao.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.cache/smoke-grade-paginacao.cjs --log-level=error && node node_modules/.cache/smoke-grade-paginacao.cjs",
