    "smoke:medicao": "esbuild scripts/smokeMedicao.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-medicao.cjs --log-level=error && node node_modules/.cache/smoke-medicao.cjs",
    "smoke:dashboard": "esbuild scripts/smokeDashboardInternas.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-dashboard.cjs --log-level=error && node node_modules/.cache/smoke-dashboard.cjs",
    "smoke:notificacoes": "esbuild scripts/smokeNotificacoesInternas.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-notificacoes.cjs --log-level=error && node node_modules/.cache/smoke-notificacoes.cjs",
