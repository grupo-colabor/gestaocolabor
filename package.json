{
  "name": "colabor-training-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke:medicao": "esbuild scripts/smokeMedicao.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-medicao.cjs --log-level=error && node node_modules/.cache/smoke-medicao.cjs",
    "smoke:dashboard": "esbuild scripts/smokeDashboardInternas.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-dashboard.cjs --log-level=error && node node_modules/.cache/smoke-dashboard.cjs",
    "smoke:notificacoes": "esbuild scripts/smokeNotificacoesInternas.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-notificacoes.cjs --log-level=error && node node_modules/.cache/smoke-notificacoes.cjs",
    "smoke:logistica": "esbuild scripts/smokeLogistica.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-logistica.cjs --log-level=error && node node_modules/.cache/smoke-logistica.cjs",
    "smoke:ociosidade": "esbuild scripts/smokeOciosidade.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-ociosidade.cjs --log-level=error && node node_modules/.cache/smoke-ociosidade.cjs",
    "smoke:custos": "esbuild scripts/smokeCustos.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-custos.cjs --log-level=error && node node_modules/.cache/smoke-custos.cjs",
    "smoke:local-online": "esbuild scripts/smokeLocalOnline.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/smoke-local-online.cjs --log-level=error && node node_modules/.cache/smoke-local-online.cjs",
